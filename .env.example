# Optional bearer auth
# API_KEY=changeme

# Idle unload (seconds). -1=never, 0=immediate
STT_MODEL_TTL=300

# HuggingFace
# HF_TOKEN=
# HF_HUB_CACHE=/cache/huggingface

# JSON list or comma-separated model ids
# PRELOAD_MODELS=["whisper-tiny"]

# Pin device: cpu | cuda:0 | cuda:1 | auto | GPU-<uuid>
# Prefer UUID at the container level (NVIDIA_VISIBLE_DEVICES / compose device_ids).
# Inside a UUID-pinned container the GPU is cuda:0.
# DEVICE_OVERRIDE=cuda:0
# STARLING_GPU_UUID=GPU-8ee934f5-a686-0f6f-8ff1-925a48f5e211

WHISPER_COMPUTE_TYPE=default
METRICS_ENABLED=true
ENABLE_UI=true
# RUNTIME_CONFIG_PATH=config/runtime.yaml
HOST=0.0.0.0
PORT=8000
